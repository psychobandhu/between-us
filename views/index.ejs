<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle || 'PsychoBandhu — Between Us' %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <!-- Floating Glass Header -->
    <header class="header">
      <a href="/" class="brand">
        <img src="/assets/logo.png" alt="PsychoBandhu" class="brand-logo" onerror="this.style.display='none'">
        <div class="brand-text">
          <h1>PsychoBandhu</h1>
          <div class="tagline">Between Us</div>
        </div>
      </a>
      <div style="display: flex; align-items: center; gap: 8px;">
        <a href="/featured" class="btn btn-secondary btn-small">
          <svg class="icon-svg" width="13" height="13" viewBox="0 0 24 24">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          Featured
        </a>
      </div>
    </header>

    <% if (flashMessage) { %>
      <div class="alert alert-warning"><%= flashMessage %></div>
    <% } %>

    <!-- Welcoming Aurora Hero Banner -->
    <div class="hero-card">
      <div class="hero-badge">
        <span class="pulse-dot"></span>
        <svg class="icon-svg" width="13" height="13" viewBox="0 0 24 24">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        100% Anonymous & Private
      </div>
      <h2 class="hero-title">Speak Freely. <span class="gradient-text">Between Us.</span></h2>
      <p class="hero-desc">
        Welcome to PsychoBandhu — <span class="accent-cyan">Judgment-free</span>. <span class="accent-lime">Identity-free</span>. Share honest thoughts, secret confessions, and private voice notes with zero tracking.
      </p>

      <div class="hero-feature-list">
        <div class="hero-feature-item">
          <svg class="icon-svg" width="14" height="14" viewBox="0 0 24 24">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Zero IP tracking, device fingerprinting, or user accounts.</span>
        </div>
        <div class="hero-feature-item">
          <svg class="icon-svg" width="14" height="14" viewBox="0 0 24 24">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>60-second voice notes and honest text confessions.</span>
        </div>
        <div class="hero-feature-item">
          <svg class="icon-svg" width="14" height="14" viewBox="0 0 24 24">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Completely safe, confidential, and judgment-free.</span>
        </div>
      </div>
    </div>

    <!-- Open Thoughts / Confessions Section (Centerpiece) -->
    <div class="open-thoughts-card">
      <div class="open-thoughts-badge">
        <svg class="icon-svg" width="14" height="14" viewBox="0 0 24 24">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        Open Thoughts Inbox
      </div>
      <h3 class="open-thoughts-title">Got something on your mind?</h3>
      <p class="open-thoughts-desc">
        Share an open thought, secret confession, or drop a voice note freely without answering a specific question.
      </p>
      <a href="/q/general" class="btn btn-primary" style="width: 100%; max-width: 440px; padding: 14px 24px; font-size: 1rem;">
        <span>Drop an Anonymous Thought or Voice Note</span>
        <svg class="icon-svg btn-arrow" width="16" height="16" viewBox="0 0 24 24">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <!-- Live Questions Section -->
    <div style="margin-bottom: 32px;">
      <div class="section-header">
        <div class="section-header-title">
          <svg class="icon-svg" width="18" height="18" viewBox="0 0 24 24">
            <path d="M12 2c.5 3 2.5 5 4 7 2 2.5 2.5 5.5 1 8.5-1.5 3-4 4.5-5 4.5s-3.5-1.5-5-4.5c-1.5-3-1-6 1-8.5 1.5-2 3.5-4 4-7z"></path>
          </svg>
          Active Questions
        </div>
        <span class="section-header-sub">Tap to answer</span>
      </div>

      <% if (activeQuestions && activeQuestions.length > 0) { %>
        <div style="display: flex; flex-direction: column; gap: 14px;">
          <% activeQuestions.forEach(q => { %>
            <a href="/q/<%= q.slug %>" class="question-list-card">
              <div style="flex: 1;">
                <div class="question-text"><%= q.text %></div>
                <div class="question-subtext">
                  <span class="question-meta-pill">
                    <svg class="icon-svg" width="12" height="12" viewBox="0 0 24 24">
                      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                    <%= (typeof countsMap[q._id.toString()] === 'object' ? countsMap[q._id.toString()]?.total : countsMap[q._id.toString()]) || 0 %> replies
                  </span>
                  <span>•</span>
                  <span class="question-meta-pill">
                    <svg class="icon-svg" width="12" height="12" viewBox="0 0 24 24">
                      <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path>
                    </svg>
                    Text & 60s Voice
                  </span>
                </div>
              </div>
              <div class="btn btn-primary btn-small" style="white-space: nowrap;">
                <span>Reply</span>
                <svg class="icon-svg btn-arrow" width="13" height="13" viewBox="0 0 24 24">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
            </a>
          <% }); %>
        </div>
      <% } else { %>
        <div class="card" style="text-align: center; padding: 36px 20px;">
          <p style="color: var(--text-secondary); margin-bottom: 8px;">No specific questions right now.</p>
          <p style="font-size: 0.88rem; color: var(--text-muted);">You can still drop open thoughts using the section above.</p>
        </div>
      <% } %>
    </div>

    <!-- Featured Responses Showcase -->
    <% if (featuredResponses && featuredResponses.length > 0) { %>
      <div style="margin-bottom: 32px;">
        <div class="section-header">
          <div class="section-header-title">
            <svg class="icon-svg" width="18" height="18" viewBox="0 0 24 24" style="color: var(--accent-sky);">
              <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3z"></path>
            </svg>
            Featured Responses
          </div>
          <a href="/featured" style="font-size: 0.82rem; color: var(--accent-sky); text-decoration: none; font-weight: 700;">View all →</a>
        </div>

        <div style="display: flex; flex-direction: column; gap: 14px;">
          <% featuredResponses.slice(0, 4).forEach(r => { %>
            <div class="featured-card">
              <% if (r.questionId) { %>
                <div class="featured-question-pill">
                  <% if (r.questionId.isGeneral || r.questionId.slug === 'general') { %>
                    <svg class="icon-svg" width="12" height="12" viewBox="0 0 24 24">
                      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                    <span>Open Thought</span>
                  <% } else { %>
                    <span>Prompt:</span> <%= r.questionId.text %>
                  <% } %>
                </div>
              <% } %>

              <div class="response-header" style="margin-top: 6px;">
                <span style="font-weight: 700; font-size: 0.82rem; color: <%= r.type === 'audio' ? '#38bdf8' : '#34d399' %>; display: inline-flex; align-items: center; gap: 6px;">
                  <% if (r.type === 'audio') { %>
                    <svg class="icon-svg" width="13" height="13" viewBox="0 0 24 24">
                      <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path>
                      <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                      <line x1="12" x2="12" y1="19" y2="22"></line>
                    </svg>
                    Anonymous Voice Note
                  <% } else { %>
                    <svg class="icon-svg" width="13" height="13" viewBox="0 0 24 24">
                      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                    Anonymous Text Note
                  <% } %>
                </span>
                <span style="font-size: 0.76rem; color: var(--text-muted);">
                  <%= new Date(r.createdAt).toLocaleDateString() %>
                </span>
              </div>

              <% if (r.type === 'text') { %>
                <div class="response-content" style="font-size: 0.98rem; margin: 8px 0;"><%= r.content %></div>
              <% } else { %>
                <div style="margin: 10px 0;">
                  <audio controls preload="none" src="/api/responses/<%= r._id %>/audio"></audio>
                </div>
              <% } %>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>

    <!-- Subtle, Low-Visibility Footer with Admin Login -->
    <footer class="site-footer">
      <div class="footer-links">
        <span>© 2026 PsychoBandhu — Between Us</span>
        <span>•</span>
        <a href="/featured" class="footer-muted-link">Featured</a>
        <span>•</span>
        <!-- Very subtle, low-contrast admin login link -->
        <a href="/admin/login" class="footer-admin-link" title="Creator Access">Admin</a>
      </div>
    </footer>
  </div>
</body>
</html>
