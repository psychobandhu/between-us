<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle || 'Featured Responses — PsychoBandhu' %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <header class="header">
      <a href="/" class="brand">
        <img src="/assets/logo.png" alt="PsychoBandhu" class="brand-logo" onerror="this.style.display='none'">
        <div class="brand-text">
          <h1>PsychoBandhu</h1>
          <div class="tagline">Between Us</div>
        </div>
      </a>
      <div style="display: flex; gap: 8px;">
        <a href="/" class="btn btn-secondary btn-small">
          <svg class="icon-svg" width="13" height="13" viewBox="0 0 24 24">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Home
        </a>
      </div>
    </header>

    <div class="hero-card">
      <div class="hero-badge">
        <svg class="icon-svg" width="13" height="13" viewBox="0 0 24 24">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
        Community Highlights
      </div>
      <h2 class="hero-title" style="font-size: 1.85rem; margin-top: 4px; margin-bottom: 8px;">
        Featured <span class="gradient-text">Responses</span>
      </h2>
      <p class="hero-desc" style="margin-top: 0;">
        Candid thoughts, heartfelt confessions, and authentic voice notes shared anonymously by respondents.
      </p>
    </div>

    <% if (featuredResponses && featuredResponses.length > 0) { %>
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <% featuredResponses.forEach(r => { %>
          <div class="featured-card">
            <% if (r.questionId) { %>
              <div class="featured-question-pill">
                <svg class="icon-svg" width="12" height="12" viewBox="0 0 24 24">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
                <span>Prompt:</span> <%= r.questionId.text %>
              </div>
            <% } %>

            <div class="response-header" style="margin-top: 8px;">
              <span style="font-weight: 700; font-size: 0.82rem; color: <%= r.type === 'audio' ? '#38bdf8' : '#34d399' %>; display: inline-flex; align-items: center; gap: 6px;">
                <% if (r.type === 'audio') { %>
                  <svg class="icon-svg" width="13" height="13" viewBox="0 0 24 24">
                    <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path>
                    <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                    <line x1="12" x2="12" y1="19" y2="22"></line>
                  </svg>
                  Anonymous Voice Note
                <% } else { %>
                  <svg class="icon-svg" width="13" height="13" viewBox="0 0 24 24">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                  </svg>
                  Anonymous Text Note
                <% } %>
              </span>
              <span style="font-size: 0.76rem; color: var(--text-muted);">
                <%= new Date(r.createdAt).toLocaleDateString() %>
              </span>
            </div>

            <% if (r.type === 'text') { %>
              <div class="response-content" style="font-size: 1.02rem; margin: 10px 0;"><%= r.content %></div>
            <% } else { %>
              <div style="margin: 10px 0;">
                <audio controls preload="none" src="/api/responses/<%= r._id %>/audio"></audio>
                <div style="font-size: 0.76rem; color: var(--text-muted); margin-top: 4px;">
                  Duration: <%= r.audio?.durationSeconds || 0 %>s
                </div>
              </div>
            <% } %>

            <% if (r.questionId && r.questionId.slug) { %>
              <div style="display: flex; justify-content: flex-end; margin-top: 10px; border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 10px;">
                <a href="/q/<%= r.questionId.slug %>" class="btn btn-secondary btn-small" style="font-size: 0.8rem;">
                  <span>Answer this prompt</span>
                  <svg class="icon-svg btn-arrow" width="12" height="12" viewBox="0 0 24 24">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            <% } %>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="card" style="text-align: center; padding: 40px 20px;">
        <p style="color: var(--text-secondary); font-size: 1rem;">
          No featured responses yet. When responses are highlighted, they will appear here.
        </p>
        <a href="/" class="btn btn-primary btn-small" style="margin-top: 16px;">Browse Questions</a>
      </div>
    <% } %>

    <footer class="site-footer">
      <div class="footer-links">
        <span>© 2026 PsychoBandhu — Between Us</span>
        <span>•</span>
        <a href="/" class="footer-muted-link">Home</a>
        <span>•</span>
        <a href="/featured" class="footer-muted-link">Featured</a>
        <span>•</span>
        <a href="/admin/login" class="footer-admin-link" title="Creator Access">Admin</a>
      </div>
    </footer>
  </div>
</body>
</html>
