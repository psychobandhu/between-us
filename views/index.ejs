<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle || 'PsychoBandhu — Between Us' %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <!-- Header with only Brand & Featured shortcut (No prominent Admin button) -->
    <header class="header">
      <a href="/" class="brand">
        <img src="/assets/logo.png" alt="PsychoBandhu" class="brand-logo" onerror="this.style.display='none'">
        <div class="brand-text">
          <h1>PsychoBandhu</h1>
          <div class="tagline">Between Us</div>
        </div>
      </a>
      <div style="display: flex; align-items: center; gap: 8px;">
        <a href="/featured" class="btn btn-secondary btn-small">★ Featured</a>
      </div>
    </header>

    <% if (flashMessage) { %>
      <div class="alert alert-warning"><%= flashMessage %></div>
    <% } %>

    <!-- Welcoming Hero Banner -->
    <!-- Welcoming Hero Banner -->
    <div class="hero-card">
      <div class="hero-badge">
        <span class="pulse-dot"></span> 100% Anonymous & Private
      </div>
      <h2>Speak Freely. Between Us.</h2>
      <p class="hero-desc">
        Welcome to PsychoBandhu! Judgment-free. Identity-free. Your thoughts. Your voice. 
      </p>
    </div>

    <!-- Open Thoughts / Confessions Section (No question needed) -->
    <div class="card" style="background: linear-gradient(135deg, rgba(56, 189, 248, 0.12) 0%, rgba(16, 185, 129, 0.08) 100%); border: 1px solid rgba(56, 189, 248, 0.25); text-align: center; padding: 26px 20px; margin-bottom: 28px;">
      <div style="font-size: 2.2rem; margin-bottom: 6px;">💭</div>
      <h3 style="font-size: 1.25rem; font-weight: 800; margin-bottom: 6px;">Got something on your mind?</h3>
      <p style="color: var(--text-secondary); font-size: 0.92rem; margin-bottom: 18px; max-width: 460px; margin-left: auto; margin-right: auto;">
        Share an open thought, secret confession, or drop a voice note freely without answering a specific question.
      </p>
      <a href="/q/general" class="btn btn-primary" style="width: 100%; max-width: 380px; font-size: 1rem; padding: 12px 20px; box-shadow: 0 4px 15px rgba(56, 189, 248, 0.3);">
        Drop an Anonymous Thought / Voice Note →
      </a>
    </div>

    <!-- Live Questions Section -->
    <div style="margin-bottom: 28px;">
      <div class="section-header">
        <h3>🔥 Active Questions</h3>
        <span style="font-size: 0.8rem; color: var(--text-secondary);">Tap to answer</span>
      </div>

      <% if (activeQuestions && activeQuestions.length > 0) { %>
        <div style="display: flex; flex-direction: column; gap: 12px;">
          <% activeQuestions.forEach(q => { %>
            <a href="/q/<%= q.slug %>" class="question-list-card">
              <div style="flex: 1;">
                <div class="question-text"><%= q.text %></div>
                <div class="question-subtext">
                  <span><%= (typeof countsMap[q._id.toString()] === 'object' ? countsMap[q._id.toString()]?.total : countsMap[q._id.toString()]) || 0 %> replies received</span>
                  <span>•</span>
                  <span>Text & 60s Voice</span>
                </div>
              </div>
              <div class="btn btn-primary btn-small" style="white-space: nowrap;">
                Reply →
              </div>
            </a>
          <% }); %>
        </div>
      <% } else { %>
        <div class="card" style="text-align: center; padding: 30px 16px;">
          <p style="color: var(--text-secondary); margin-bottom: 8px;">No specific questions right now.</p>
          <p style="font-size: 0.85rem; color: var(--text-secondary);">You can still drop open thoughts using the section above!</p>
        </div>
      <% } %>
    </div>

    <!-- Featured Responses Showcase -->
    <% if (featuredResponses && featuredResponses.length > 0) { %>
      <div style="margin-bottom: 28px;">
        <div class="section-header">
          <h3>✨ Featured Responses</h3>
          <a href="/featured" style="font-size: 0.82rem; color: var(--accent); text-decoration: none;">View all →</a>
        </div>

        <div style="display: flex; flex-direction: column; gap: 12px;">
          <% featuredResponses.slice(0, 4).forEach(r => { %>
            <div class="featured-card">
              <% if (r.questionId) { %>
                <div class="featured-question-pill">
                  <% if (r.questionId.isGeneral || r.questionId.slug === 'general') { %>
                    <span>💭</span> Open Thought
                  <% } else { %>
                    <span>Q:</span> <%= r.questionId.text %>
                  <% } %>
                </div>
              <% } %>

              <div class="response-header" style="margin-top: 6px;">
                <span style="font-weight: 600; font-size: 0.82rem; color: <%= r.type === 'audio' ? '#38bdf8' : 'var(--accent)' %>;">
                  <%= r.type === 'audio' ? '🎤 Anonymous Voice' : '💬 Anonymous Note' %>
                </span>
                <span style="font-size: 0.75rem; color: var(--text-secondary);">
                  <%= new Date(r.createdAt).toLocaleDateString() %>
                </span>
              </div>

              <% if (r.type === 'text') { %>
                <div class="response-content" style="font-size: 0.98rem; margin: 8px 0;"><%= r.content %></div>
              <% } else { %>
                <div style="margin: 8px 0;">
                  <audio controls preload="none" src="/api/responses/<%= r._id %>/audio"></audio>
                </div>
              <% } %>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>

    <!-- Subtle, Low-Visibility Footer with Admin Login -->
    <footer class="site-footer">
      <div class="footer-links">
        <span>© 2026 PsychoBandhu — Between Us</span>
        <span>•</span>
        <a href="/featured" class="footer-muted-link">Featured</a>
        <span>•</span>
        <!-- Very subtle, low-contrast admin login link -->
        <a href="/admin/login" class="footer-admin-link" title="Creator Access">Admin</a>
      </div>
    </footer>
  </div>
</body>
</html>
