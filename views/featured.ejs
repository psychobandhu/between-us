<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle || 'Featured Responses — PsychoBandhu' %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <header class="header">
      <a href="/" class="brand">
        <img src="/assets/logo.png" alt="PsychoBandhu" class="brand-logo" onerror="this.style.display='none'">
        <div class="brand-text">
          <h1>PsychoBandhu</h1>
          <div class="tagline">Between Us</div>
        </div>
      </a>
      <div style="display: flex; gap: 8px;">
        <a href="/" class="btn btn-secondary btn-small">← Home</a>
      </div>
    </header>

    <div class="hero-card">
      <span class="badge-featured">Community Highlights</span>
      <h2 style="font-size: 1.5rem; margin-top: 8px; margin-bottom: 6px;">Featured Responses</h2>
      <p style="color: var(--text-secondary); font-size: 0.95rem;">
        Candid thoughts, heartfelt confessions, and authentic voice notes shared anonymously.
      </p>
    </div>

    <% if (featuredResponses && featuredResponses.length > 0) { %>
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <% featuredResponses.forEach(r => { %>
          <div class="featured-card">
            <% if (r.questionId) { %>
              <div class="featured-question-pill">
                <span>Q:</span> <%= r.questionId.text %>
              </div>
            <% } %>

            <div class="response-header" style="margin-top: 8px;">
              <span style="font-weight: 600; font-size: 0.85rem; color: <%= r.type === 'audio' ? '#38bdf8' : 'var(--accent)' %>;">
                <%= r.type === 'audio' ? '🎤 Anonymous Voice' : '💬 Anonymous Note' %>
              </span>
              <span style="font-size: 0.78rem; color: var(--text-secondary);">
                <%= new Date(r.createdAt).toLocaleDateString() %>
              </span>
            </div>

            <% if (r.type === 'text') { %>
              <div class="response-content" style="font-size: 1.05rem; margin: 10px 0;"><%= r.content %></div>
            <% } else { %>
              <div style="margin: 10px 0;">
                <audio controls preload="none" src="/api/responses/<%= r._id %>/audio"></audio>
                <div style="font-size: 0.78rem; color: var(--text-secondary); margin-top: 4px;">
                  Duration: <%= r.audio?.durationSeconds || 0 %>s
                </div>
              </div>
            <% } %>

            <% if (r.questionId && r.questionId.slug) { %>
              <div style="display: flex; justify-content: flex-end; margin-top: 8px; border-top: 1px solid var(--border); padding-top: 8px;">
                <a href="/q/<%= r.questionId.slug %>" class="btn btn-secondary btn-small" style="font-size: 0.78rem;">
                  Answer this question →
                </a>
              </div>
            <% } %>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="card" style="text-align: center; padding: 40px 20px;">
        <p style="color: var(--text-secondary); font-size: 1rem;">
          No featured responses yet. When the creator highlights responses, they will appear here!
        </p>
        <a href="/" class="btn btn-primary btn-small" style="margin-top: 16px;">Browse Questions</a>
      </div>
    <% } %>

    <footer class="site-footer">
      <div class="footer-links">
        <span>© 2026 PsychoBandhu — Between Us</span>
        <span>•</span>
        <a href="/" class="footer-muted-link">Home</a>
        <span>•</span>
        <a href="/featured" class="footer-muted-link">Featured</a>
        <span>•</span>
        <a href="/admin/login" class="footer-admin-link" title="Creator Access">Admin</a>
      </div>
    </footer>
  </div>
</body>
</html>
